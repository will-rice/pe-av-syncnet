+class ContrastiveLoss(nn.Module):
+    """Contrastive loss for metric learning.
+
+    This loss function pulls together embeddings of positive pairs (synchronized
+    audio-video) and pushes apart embeddings of negative pairs (out-of-sync).
+
+    For positive pairs: L = D²
+    For negative pairs: L = max(margin - D, 0)²
+
+    where D is the Euclidean distance between embeddings.
+
+    Args:
+        margin: Minimum distance for negative pairs. Pairs further than this
+            margin incur no loss. Default: 1.0.
+    """
+
+    def __init__(self, margin: float = 1.0) -> None:
+        super().__init__()
+        self.margin = margin
+
+    def forward(
+        self,
+        audio_embeds: torch.Tensor,
+        video_embeds: torch.Tensor,
+        labels: torch.Tensor,
+    ) -> torch.Tensor:
+        """Compute contrastive loss.
+
+        Args:
+            audio_embeds: Audio embeddings. Shape: (batch_size, embed_dim).
+            video_embeds: Video embeddings. Shape: (batch_size, embed_dim).
+            labels: Binary labels where 1 = synced (positive), 0 = out-of-sync.
+                Shape: (batch_size,).
+
+        Returns:
+            Scalar loss tensor.
+        """
+        distance = F.pairwise_distance(audio_embeds, video_embeds)
+        positive_loss = labels * distance.pow(2)
+        negative_loss = (1 - labels) * torch.clamp(self.margin - distance, min=0).pow(2)
+        return (positive_loss + negative_loss).mean()
+
+
